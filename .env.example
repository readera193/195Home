# 複製為 .env（已被 .gitignore 排除）後填入真實值，勿提交版控。
# 全部留空／不設定也能啟動：資料庫密碼與密鑰使用僅限本機的開發預設值，
# 登入頁只會有 Demo 體驗；填入 LINE 憑證並重新 --build 後才會出現 LINE 登入。
#   Copy-Item .env.example .env

# --- 資料庫與密鑰（選填；不設定則用 docker-compose.yml 內的開發預設值）---
# 注意：MySQL 的帳號密碼只在資料目錄第一次建立時生效，之後修改需 docker compose down -v 重建 volume。
# MYSQL_ROOT_PASSWORD=
# APP_DB_PASSWORD=
# NOTIFICATION_DB_PASSWORD=
# JWT_SECRET=            # 至少 32 bytes
# INTERNAL_TOKEN=        # app-service 與 notification-service 之間的內部呼叫密鑰

# --- LINE ---
# LINE Login channel（LINE Developers Console → Provider → LINE Login channel → Basic settings）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 須與 Console「LINE Login」分頁的 Callback URL 完全一致
LINE_LOGIN_REDIRECT_URI=http://localhost:8080/login/callback

# Messaging API channel（同一個 Provider 下的 Messaging API channel）
# Channel secret：Basic settings 分頁；Channel access token：Messaging API 分頁 → Issue
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=
