{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compose: up",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": []
    },
    {
      "label": "mysql: up",
      "type": "shell",
      "command": "docker compose up -d --wait mysql",
      "problemMatcher": []
    },
    {
      "label": "dev: app-service + frontend",
      "dependsOn": ["frontend: dev", "app-service: run (dev profile)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "dev: 啟動 MySQL + 前後端",
      "dependsOn": ["mysql: up", "dev: app-service + frontend"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "compose: down (清除資料)",
      "type": "shell",
      "command": "docker compose down -v",
      "problemMatcher": []
    },
    {
      "label": "app-service: test",
      "type": "shell",
      "command": "./mvnw -B test",
      "options": { "cwd": "${workspaceFolder}/app-service" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "app-service: test (略過需 Docker 的整合測試)",
      "type": "shell",
      "command": "./mvnw -B test -Dtest='!*IntegrationTest'",
      "options": { "cwd": "${workspaceFolder}/app-service" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "app-service: run (dev profile)",
      "type": "shell",
      "command": "./mvnw spring-boot:run '-Dspring-boot.run.profiles=dev'",
      "windows": { "command": "./mvnw.cmd spring-boot:run '-Dspring-boot.run.profiles=dev'" },
      "options": { "cwd": "${workspaceFolder}/app-service" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "notification-service: test",
      "type": "shell",
      "command": "./mvnw -B test",
      "options": { "cwd": "${workspaceFolder}/notification-service" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "notification-service: run (dev profile)",
      "type": "shell",
      "command": "./mvnw spring-boot:run '-Dspring-boot.run.profiles=dev'",
      "windows": { "command": "./mvnw.cmd spring-boot:run '-Dspring-boot.run.profiles=dev'" },
      "options": { "cwd": "${workspaceFolder}/notification-service" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "frontend: lint + test + build",
      "type": "shell",
      "command": "npm run lint && npm test && npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
