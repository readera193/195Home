# 複製為 .env（已被 .gitignore 排除）後填入真實值，勿提交版控。
#   Copy-Item line.env.example .env

# LINE Login channel（LINE Developers Console → Provider → LINE Login channel → Basic settings）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 須與 Console「LINE Login」分頁的 Callback URL 完全一致
LINE_LOGIN_REDIRECT_URI=http://localhost:8080/login/callback

# Messaging API channel（同一個 Provider 下的 Messaging API channel）
# Channel secret：Basic settings 分頁；Channel access token：Messaging API 分頁 → Issue
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=
